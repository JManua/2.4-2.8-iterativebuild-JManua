body {
	font-family: Arial, sans-serif;
	margin: 0;
	padding: 0;
	min-height: 150vh;
	display: flex;
	flex-direction: column;
	font-family: 'Open Sans', sans-serif;
}


header {
	background-color: #2F8D49;
	color: #fff;
	padding: 50px;
	text-align: center;
	display: flex;
	align-items: center;
}


.logo-placeholder {
	width: 100px;
	height: 100px;
	background-color: #fff;
	border: 1px solid #ccc;
	margin-right: 20px;
}


.text {
  vertical-align: top;
}


header h1 {
	margin: 0;
}


nav {
  background-color: #2F8D49;
  padding: 30px;
  text-align: right;
}

nav ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  justify-content: space-between;
}

nav a {
  color: #fff;
  text-decoration: none;
  font-size: 24px; /* reduce font size from 24px to 16px */
}

nav li {
  margin-right: 5%; /* add space between buttons */
  padding: 5px 10px;
}

nav a:hover {
  color: #ccc;
}	

.header-bar {
  position: relative;
  height: 40px; /* adjust the height to your liking */
}

.yellow-bar {
  background-color: #fff; /* yellow */
  width: 100%;
  height: 50%; /* half the height of the container */
  position: absolute;
  top: 0;
  left: 0;
}

.red-bar {
  background-color: #FF2121; /* red */
  width: 100%;
  height: 50%; /* half the height of the container */
  position: absolute;
  top: 50%; /* start from the middle of the container */
  left: 0;
}

.container {
  display: flex;
  align-items: center;
}



.yellow-line {
  width: 30px;
  height: 5px;
  background-color: #fff;
  margin-left: 210px;
}

.red-line {
  width: 30px;
  height: 5px;
  background-color: #FF2121;
  margin-left: 0px;
}

.yellow-line-2 {
  width: 30px;
  height: 5px;
  background-color: #fff;
  margin-left: 1230px;
}

.red-line-2 {
  width: 30px;
  height: 5px;
  background-color: #FF2121;
  margin-left: 0px;
}

